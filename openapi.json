  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-openasy-session",
        "description": "The browser session after signing in (`openasy-session` when backups runs on plain http://localhost). Requests that change something must come from the backups origin."
      },
      "apiToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "An API token created under Settings \u2192 API tokens (`oa_backups_...`): one role, always an expiry (ADR 0003)."
      },
      "adminToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Only when backups is started by its tests or a local script: one shared token with the admin role. A production install does not have it."
      },
      "ingestToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "`BACKUPS_INGEST_TOKEN`: for the jobs. It can send runs and restore tests, nothing else."
      }
    },
    "responses": {
      "Problem": {
        "description": "An error, as RFC 9457 Problem Details.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "enum": [
              "invalid-token",
              "invalid-json",
              "invalid-body",
              "conflict",
              "invalid-report",
              "unknown-job",
              "not-found",
              "not-configured",
              "payload-too-large",
              "internal-error",
              "unauthenticated",
              "invalid-credentials",
              "mfa-required",
              "mfa-setup-required",
              "forbidden",
              "cross-site",
              "rate-limited"
            ],
            "description": "Stable; match on this."
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "ProductLink": {
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The product, as OpenAsy names it.",
            "examples": [
              "infrastructure"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The address people open it at.",
            "examples": [
              "https://infra.example.com"
            ]
          }
        }
      },
      "ProductList": {
        "type": "object",
        "required": [
          "products"
        ],
        "properties": {
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductLink"
            }
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "Version": {
        "type": "object",
        "required": [
          "product",
          "version"
        ],
        "properties": {
          "product": {
            "const": "backups"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Tool": {
        "type": "string",
        "enum": [
          "restic",
          "velero",
          "other"
        ]
      },
      "JobState": {
        "type": "string",
        "enum": [
          "healthy",
          "late",
          "at-risk",
          "failing",
          "untested",
          "unknown"
        ],
        "description": "`failing`: the last runs all failed. `at-risk`: the last backup is older than the RPO. `late`: older than one and a half cadences. `untested`: no successful restore test within the stale period. `unknown`: nothing reported. Checked in this order."
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "name",
          "tool",
          "source",
          "location",
          "cadenceHours",
          "rpoHours",
          "retention",
          "owner",
          "tags",
          "state",
          "reason",
          "lastRun",
          "lastSuccessAt",
          "lastRestoreTest",
          "successRate30d",
          "sizeBytes",
          "createdAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tool": {
            "$ref": "#/components/schemas/Tool"
          },
          "source": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "cadenceHours": {
            "type": "integer"
          },
          "rpoHours": {
            "type": "integer",
            "description": "How many hours of data may be lost."
          },
          "retention": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "state": {
            "$ref": "#/components/schemas/JobState"
          },
          "reason": {
            "type": "string",
            "description": "Why the job is in this state, in a sentence."
          },
          "lastRun": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "endedAt",
                  "status"
                ],
                "additionalProperties": false,
                "properties": {
                  "endedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "success",
                      "warning",
                      "failed"
                    ]
                  }
                }
              }
            ]
          },
          "lastSuccessAt": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ],
            "description": "The last run that was not failed."
          },
          "lastRestoreTest": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "testedAt",
                  "ok",
                  "verifiedBy",
                  "ageDays"
                ],
                "additionalProperties": false,
                "properties": {
                  "testedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "ok": {
                    "type": "boolean"
                  },
                  "verifiedBy": {
                    "type": "string",
                    "enum": [
                      "automated",
                      "manual"
                    ]
                  },
                  "ageDays": {
                    "type": "integer"
                  }
                }
              }
            ]
          },
          "successRate30d": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "number"
              }
            ],
            "description": "Runs that were not failed over all runs in 30 days, 0 to 1."
          },
          "sizeBytes": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer"
              }
            ],
            "description": "Size of the last run that reported one."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "JobList": {
        "type": "object",
        "required": [
          "jobs"
        ],
        "properties": {
          "jobs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Job"
            }
          },
          "nextCursor": {
            "type": "string",
            "description": "Pass the previous page's nextCursor to get the next page."
          }
        }
      },
      "NewJob": {
        "type": "object",
        "required": [
          "name",
          "cadenceHours",
          "rpoHours"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "tool": {
            "$ref": "#/components/schemas/Tool",
            "default": "other"
          },
          "source": {
            "type": "string",
            "maxLength": 500
          },
          "location": {
            "type": "string",
            "maxLength": 500
          },
          "cadenceHours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8760
          },
          "rpoHours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8760,
            "description": "Not less than cadenceHours."
          },
          "retention": {
            "type": "string",
            "maxLength": 200
          },
          "owner": {
            "type": "string",
            "maxLength": 100
          },
          "tags": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,32}$"
            }
          }
        }
      },
      "UpdateJob": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tool": {
            "$ref": "#/components/schemas/Tool",
            "default": "other"
          },
          "source": {
            "type": "string",
            "maxLength": 500
          },
          "location": {
            "type": "string",
            "maxLength": 500
          },
          "cadenceHours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8760
          },
          "rpoHours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8760,
            "description": "Not less than cadenceHours."
          },
          "retention": {
            "type": "string",
            "maxLength": 200
          },
          "owner": {
            "type": "string",
            "maxLength": 100
          },
          "tags": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,32}$"
            }
          }
        },
        "minProperties": 1
      },
      "Run": {
        "type": "object",
        "required": [
          "id",
          "startedAt",
          "endedAt",
          "status",
          "snapshotId",
          "sizeBytes",
          "filesNew",
          "filesChanged",
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "endedAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "warning",
              "failed"
            ]
          },
          "snapshotId": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "sizeBytes": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer"
              }
            ]
          },
          "filesNew": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer"
              }
            ]
          },
          "filesChanged": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer"
              }
            ]
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ],
            "description": "Passwords and tokens are masked."
          }
        }
      },
      "RunList": {
        "type": "object",
        "required": [
          "runs"
        ],
        "properties": {
          "runs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Run"
            }
          },
          "nextCursor": {
            "type": "string",
            "description": "Pass the previous page's nextCursor to get the next page."
          }
        }
      },
      "NewRestoreTest": {
        "type": "object",
        "required": [
          "job",
          "testedAt",
          "ok",
          "verifiedBy"
        ],
        "additionalProperties": false,
        "properties": {
          "job": {
            "type": "string"
          },
          "testedAt": {
            "type": "string",
            "format": "date-time"
          },
          "ok": {
            "type": "boolean"
          },
          "durationSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "snapshotId": {
            "type": "string",
            "maxLength": 256
          },
          "verifiedBy": {
            "type": "string",
            "enum": [
              "automated",
              "manual"
            ]
          },
          "notes": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "RestoreTest": {
        "type": "object",
        "required": [
          "id",
          "testedAt",
          "ok",
          "durationSeconds",
          "snapshotId",
          "verifiedBy",
          "notes",
          "reportedBy"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "testedAt": {
            "type": "string",
            "format": "date-time"
          },
          "ok": {
            "type": "boolean"
          },
          "durationSeconds": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer"
              }
            ]
          },
          "snapshotId": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "verifiedBy": {
            "type": "string",
            "enum": [
              "automated",
              "manual"
            ]
          },
          "notes": {
            "type": "string"
          },
          "reportedBy": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          }
        }
      },
      "RestoreTestList": {
        "type": "object",
        "required": [
          "restoreTests"
        ],
        "properties": {
          "restoreTests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RestoreTest"
            }
          },
          "nextCursor": {
            "type": "string",
            "description": "Pass the previous page's nextCursor to get the next page."
          }
        }
      },
      "Settings": {
        "type": "object",
        "required": [
          "autoCreate",
          "restoreStaleDays",
          "failingRuns"
        ],
        "additionalProperties": false,
        "properties": {
          "autoCreate": {
            "type": "boolean",
            "description": "A report for a job nobody defined creates it, with a cadence of 24 hours and an RPO of 48."
          },
          "restoreStaleDays": {
            "type": "integer"
          },
          "failingRuns": {
            "type": "integer"
          }
        }
      },
      "UpdateSettings": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "autoCreate": {
            "type": "boolean"
          },
          "restoreStaleDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          },
          "failingRuns": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        }
      },
      "Summary": {
        "type": "object",
        "required": [
          "jobs",
          "states",
          "autoCreate",
          "lastRunAt"
        ],
        "additionalProperties": false,
        "properties": {
          "jobs": {
            "type": "integer"
          },
          "states": {
            "type": "object",
            "required": [
              "failing",
              "at-risk",
              "late",
              "untested",
              "unknown",
              "healthy"
            ],
            "additionalProperties": false,
            "properties": {
              "failing": {
                "type": "integer"
              },
              "at-risk": {
                "type": "integer"
              },
              "late": {
                "type": "integer"
              },
              "untested": {
                "type": "integer"
              },
              "unknown": {
                "type": "integer"
              },
              "healthy": {
                "type": "integer"
              }
            }
          },
          "autoCreate": {
            "type": "boolean"
          },
          "lastRunAt": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          }
        }
      }
    }
  }
}
